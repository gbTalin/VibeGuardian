{
  "name": "guardian-unit-penetration-testing-agent",
  "version": "0.1.0",
  "description": "Hackathon-ready local security release gate with safe source checks and explicitly authorized URL probing.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "guardian-unit": "./bin/guardian-unit.mjs"
  },
  "scripts": {
    "start": "node bin/guardian-unit.mjs ui",
    "scan": "node bin/guardian-unit.mjs scan",
    "setup-demo": "node scripts/setup-demo.mjs",
    "demo": "node scripts/run-demo.mjs",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "keywords": [
    "security",
    "appsec",
    "sast",
    "secrets",
    "local-first",
    "air-gapped",
    "ai-security",
    "supply-chain",
    "penetration-testing",
    "release-gate",
    "vibe-coding"
  ],
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "plugins/",
    "templates/",
    "security/",
    "examples/clean-app/",
    ".guardian-unit/targets.example.json",
    ".github/workflows/guardian-unit-gate.yml",
    "action.yml",
    "README.md",
    "LICENSE"
  ]
}
