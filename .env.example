CG_ENVIRONMENT=development
CG_DATABASE_URL=sqlite:///./cyberguard_plugin.db
CG_API_PREFIX=/v1
CG_CORS_ORIGINS=http://localhost:3000
# Store the one-time Exa Monitor webhook secret in a managed secret store in production.
CG_EXA_WEBHOOK_SECRET=replace-with-a-development-secret
# Shared secret for CyberGuard's release-event adapter; use a managed secret in production.
CG_RELEASE_WEBHOOK_SECRET=replace-with-a-different-development-secret
CG_LOCAL_ENCRYPTION_KEY=generate-a-fernet-key-for-local-development
